# Sólo se versionan las skills propias. Las de terceros (ponytail, streamlit)
# y synced/ (lo descarga claude.ai y lo pisa en cada sincronización) quedan afuera.
/*
!/.gitignore
!/README.md
!/provenance/
!/tokenwise/
!/kiln/
!/compass/
!/assay/
!/quarry/
!/hallmark/
!/foundry/
!/sherpa/
!/foreman/
!/lenses/
!/herald/
!/mapa/
!/.claude-plugin/
!/dist/
!/empaquetar.py
!/LICENSE
!/AGENTS.md
!/adaptadores/
!/docs/
# De terceros, con licencia libre y su LICENSE: se versionan para tenerlas en cualquier PC.
!/impeccable/
!/design-taste-frontend/
__pycache__/
**/evals/results/

# Credenciales y entornos de los conectores de ejemplo: nunca se versionan.
client_secret*.json
token.json
.venv/
